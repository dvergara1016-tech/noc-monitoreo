# Copia este archivo como ".env" y completa los valores.
# El archivo ".env" NO se sube a GitHub (está en .gitignore).

# Grafana (token de cuenta de servicio con permiso de lectura)
GRAFANA_TOKEN=

# Zabbix (dirección de la API y token de API)
ZABBIX_API_URL=http://IP-DE-TU-ZABBIX/api_jsonrpc.php
ZABBIX_API_TOKEN=

# Telegram (opcional: déjalos vacíos si no usas notificaciones)
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# UID de la fuente de datos de Zabbix en Grafana
# (Grafana > Connections > Data sources > Zabbix: está al final de la URL).
# Si lo dejas vacío se usa el valor por defecto del código.
ZABBIX_DS_UID=
